[Unit]
Description=Weston kiosk compositor (DRM/KMS)
After=systemd-user-sessions.service
Conflicts=getty@tty1.service

[Service]
ExecStartPre=/bin/mkdir -p /run/weston
Environment=XDG_RUNTIME_DIR=/run/weston
Environment=WESTON_DISABLE_ABSTRACT_FD=1
ExecStart=/usr/bin/weston --backend=drm-backend.so --config=/etc/xdg/weston/weston.ini --log=/var/log/weston.log
Restart=always
RestartSec=2
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal

[Install]
WantedBy=graphical.target
