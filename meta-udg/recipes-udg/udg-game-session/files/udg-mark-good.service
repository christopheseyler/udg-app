[Unit]
Description=Mark the current RAUC slot good after a successful boot
After=udg-game.service
Requires=udg-game.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Crude "did it actually come up" signal: give the game time to reach its
# title screen before confirming the slot. Replace with a real readiness
# check (e.g. the game touching a status file/socket once its title
# screen is showing) if 30s proves too short/long in practice.
ExecStartPre=/bin/sleep 30
ExecStart=/usr/bin/rauc status mark-good

[Install]
WantedBy=graphical.target
