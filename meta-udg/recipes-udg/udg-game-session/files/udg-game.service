[Unit]
Description=Ultimate Darts Game (Godot, fullscreen on Weston)
After=udg-weston.service
Requires=udg-weston.service

[Service]
Environment=XDG_RUNTIME_DIR=/run/weston
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=/usr/bin/udg-game --fullscreen --rendering-driver opengl3
# Weston's socket may not be up yet on the first try after boot; retry.
Restart=on-failure
RestartSec=2
StartLimitIntervalSec=60
StartLimitBurst=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
