# Fragment to paste into build/conf/local.conf. See ../README.md for the
# full walkthrough (layers, branches, first build).

MACHINE = "rock-5c"
DISTRO = "poky"

DISTRO_FEATURES:append = " rauc opengl wayland pam"
INIT_MANAGER = "systemd"

IMAGE_FSTYPES:append = " ext4"
WKS_FILE = "rock5c-rauc.wks.in"
WIC_CREATE_EXTRA_ARGS = "--no-fstab-update"

# meta-rockchip (community/mainline layer) machine feature that supplies
# the U-Boot environment binary used by the "uboot_env" wic partition.
# UNVERIFIED - see README "First build checklist": if meta-rockchip's
# wic plugin doesn't recognize this, drop it and set RK_UBOOT_ENV to an
# explicit --source in wic/rock5c-rauc.wks.in instead.
MACHINE_FEATURES:append = " rk-u-boot-env"

# extlinux.conf entries generated for /boot: pulls in the slot U-Boot
# selected in boot.cmd (bootpart, raucslot - see
# recipes-bsp/u-boot/files/boot.cmd).
UBOOT_EXTLINUX_KERNEL_IMAGE = "/${KERNEL_IMAGETYPE}"
UBOOT_EXTLINUX_ROOT = "root=PARTLABEL=${bootpart}"
UBOOT_EXTLINUX_KERNEL_ARGS = "rootwait rw rootfstype=ext4 rauc.slot=${raucslot}"

# Convenience for target debugging.
EXTRA_IMAGE_FEATURES:append = " debug-tweaks ssh-server-openssh"
