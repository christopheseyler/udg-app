[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://shared_screens/game_setup_panel/player_edit_panel.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://assets/ui/setup/icon_database.svg" id="2_db_icon"]

[node name="PlayerEditPanel" type="VBoxContainer"]
theme_override_constants/separation = 32
script = ExtResource("1_script")

[node name="TitleLabel" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"SetupTitle"
text = "Edit player"
horizontal_alignment = 1
vertical_alignment = 1

[node name="NameRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 24

[node name="NameEdit" type="LineEdit" parent="NameRow"]
custom_minimum_size = Vector2(0, 80)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"NameEdit"
theme_override_font_sizes/font_size = 44
placeholder_text = "Player name"
max_length = 24
alignment = 1

[node name="DatabaseButton" type="Button" parent="NameRow"]
custom_minimum_size = Vector2(140, 100)
layout_mode = 2
tooltip_text = "Player database"
theme_type_variation = &"PillButton"
icon = ExtResource("2_db_icon")
icon_alignment = 1
expand_icon = true

[node name="Buttons" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 80
alignment = 1

[node name="CancelButton" type="Button" parent="Buttons"]
custom_minimum_size = Vector2(300, 120)
layout_mode = 2
theme_type_variation = &"PillButton"
text = "Cancel"

[node name="OkButton" type="Button" parent="Buttons"]
custom_minimum_size = Vector2(300, 120)
layout_mode = 2
theme_type_variation = &"PillButton"
text = "OK"
